{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuubikprojekt.ee/schemas/kdraw-v1.schema.json",
  "title": "KDrawDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "units",
    "currentLayerId",
    "entities",
    "layers",
    "linetypes",
    "textStyles",
    "dimensionStyles",
    "blocks",
    "layouts",
    "attachments",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "units": { "$ref": "#/$defs/units" },
    "currentLayerId": { "type": "string", "minLength": 1 },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" }, "minItems": 1 },
    "linetypes": { "type": "array", "items": { "type": "object" } },
    "textStyles": { "type": "array", "items": { "type": "object" } },
    "dimensionStyles": { "type": "array", "items": { "type": "object" } },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "layouts": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
    "attachments": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{3}([0-9A-Fa-f]{3})?$" },
        "colorMethod": { "enum": ["aci", "trueColor"] },
        "aciIndex": { "type": "integer", "minimum": 1, "maximum": 255 },
        "linetypeId": { "type": "string", "minLength": 1 },
        "lineweightMm": { "type": "number", "minimum": 0 },
        "transparency": { "type": "number", "minimum": 0, "maximum": 90 }
      },
      "allOf": [
        {
          "if": { "anyOf": [{ "required": ["aciIndex"] }, { "required": ["colorMethod"] }] },
          "then": { "required": ["color"] }
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "paperRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "plotArea": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "layout" } } },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "extents" } } },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "display" } } },
        { "type": "object", "required": ["kind", "window"], "properties": { "kind": { "const": "window" }, "window": { "$ref": "#/$defs/paperRect" } } }
      ]
    },
    "plotScale": {
      "oneOf": [
        { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "fit" } } },
        {
          "type": "object",
          "required": ["mode", "paperUnits", "drawingUnits"],
          "properties": {
            "mode": { "const": "custom" },
            "paperUnits": { "type": "number", "exclusiveMinimum": 0 },
            "drawingUnits": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "plotStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "plotLineweights", "plotTransparency"],
      "properties": {
        "profile": { "enum": ["color", "monochrome", "grayscale"] },
        "plotLineweights": { "type": "boolean" },
        "plotTransparency": { "type": "boolean" }
      }
    },
    "pageSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaName", "orientation", "plotArea", "plotScale", "centerPlot", "plotOriginMm"],
      "properties": {
        "mediaName": { "type": "string", "minLength": 1 },
        "orientation": { "enum": ["portrait", "landscape"] },
        "plotArea": { "$ref": "#/$defs/plotArea" },
        "plotScale": { "$ref": "#/$defs/plotScale" },
        "centerPlot": { "type": "boolean" },
        "plotOriginMm": { "$ref": "#/$defs/point" },
        "plotStyle": { "$ref": "#/$defs/plotStyle" },
        "displayPlotStyles": { "type": "boolean" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["id", "name", "kind", "viewports"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["model", "paper"] },
        "pageSetup": { "$ref": "#/$defs/pageSetup" },
        "viewports": { "type": "array", "items": { "type": "object" } },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linear", "displayPrecision", "angularPrecision"],
      "properties": {
        "linear": { "enum": ["unitless", "mm", "cm", "m", "in", "ft"] },
        "displayPrecision": { "type": "integer", "minimum": 0, "maximum": 15 },
        "angularPrecision": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "entityBase": {
      "type": "object",
      "required": ["kind", "handle", "layerId"],
      "properties": {
        "kind": { "type": "string" },
        "handle": { "type": "string", "minLength": 1 },
        "layerId": { "type": "string", "minLength": 1 },
        "appearance": { "$ref": "#/$defs/appearance" },
        "extensionData": { "type": "object" }
      }
    },
    "entity": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "oneOf": [
            {
              "properties": {
                "kind": { "const": "line" },
                "start": { "$ref": "#/$defs/point" },
                "end": { "$ref": "#/$defs/point" }
              },
              "required": ["start", "end"]
            },
            {
              "properties": {
                "kind": { "const": "circle" },
                "center": { "$ref": "#/$defs/point" },
                "radius": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["center", "radius"]
            },
            {
              "properties": {
                "kind": {
                  "enum": ["polyline", "arc", "ellipse", "spline", "text", "mtext", "leader", "dimension", "hatch", "blockRef"]
                }
              }
            },
            {
              "properties": {
                "kind": { "const": "proxy" },
                "originalType": { "type": "string", "minLength": 1 },
                "raw": {}
              },
              "required": ["originalType", "raw"]
            }
          ]
        }
      ]
    },
    "layer": {
      "type": "object",
      "required": ["id", "name", "visible", "frozen", "locked", "plottable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "frozen": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "plottable": { "type": "boolean" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "name", "basePoint", "entities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "basePoint": { "$ref": "#/$defs/point" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } }
      }
    }
  }
}
